{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "deepccc-agent/src/**/*.ts"],
  "exclude": ["src/__tests__/**", "deepccc-agent/src/__tests__/**"]
}
